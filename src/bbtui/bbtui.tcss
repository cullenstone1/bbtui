/* Rounded, titled borders on every panel, as in jiratui; the focused panel lights up. */

#search,
#starred,
#others,
#pull-requests,
#summary,
#merge-checks,
#builds,
#reviewers,
#description,
#general-comments,
#file-chooser,
#diff-view,
.comment {
    border: round $primary-lighten-3;
    border-title-color: $primary-lighten-3;
    border-subtitle-color: $primary-lighten-3;
    background: transparent;
}

#search:focus,
#starred:focus,
#others:focus,
#pull-requests:focus,
#overview-scroll:focus #summary,
#file-chooser:focus,
#diff-view:focus {
    border: round $accent;
    border-title-color: $accent;
    border-subtitle-color: $accent;
}

#search {
    height: 3;
    padding: 0 1;
}

#dashboard {
    height: 1fr;
}

#starred {
    height: auto;
    max-height: 50%;
}

#others,
#pull-requests,
#diff-view {
    height: 1fr;
}

#file-chooser {
    height: auto;
    max-height: 12;
}

#general-comments {
    height: auto;
    padding: 0 1;
}

#summary,
#merge-checks,
#builds,
#reviewers {
    height: auto;
    padding: 0 1;
}

#checks-row {
    height: auto;
}

#merge-checks,
#builds {
    width: 1fr;
}

#description {
    height: auto;
    margin: 0;
    padding: 0 1;
}

.diff-lines {
    width: auto;
}

.comment {
    height: auto;
    margin: 0;
    padding: 0 1;
}

#diff-view .comment {
    width: 100%;
    max-width: 120;
}

TabPane {
    padding: 0;
}

/* Markdown spaces blocks with a bottom margin; drop it on the last block so boxes fit snugly. */
.comment > MarkdownBlock:last-child,
#description > MarkdownBlock:last-child {
    margin-bottom: 0;
}

/* Dashboard repository rows: name | description | updated, aligned in columns. */
.repo-row {
    height: 1;
    padding: 0 1;
}

.repo-name {
    width: 32;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.repo-description {
    width: 1fr;
    padding: 0 2;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.repo-updated {
    width: 14;
    text-align: right;
    color: $text-muted;
}

/* Comment cards are focusable (Tab or click) so `c` can reply to them. */
.comment:focus {
    border: round $accent;
    border-title-color: $accent;
}

CommentComposer {
    align: center middle;
    background: $background 60%;
}

#composer {
    width: 90%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 0 1;
}

#composer-quote {
    max-height: 6;
    margin-bottom: 1;
    border-left: thick $primary-lighten-3;
    padding-left: 1;
}

#composer-text {
    height: 12;
    border: none;
}

#composer-hint {
    margin-top: 1;
}

/* New pull request form */
#create-form {
    height: 1fr;
}

#create-branches,
#create-details {
    height: auto;
}

.branch-picker,
#create-title,
#create-description,
#create-reviewers,
#create-preview {
    border: round $primary-lighten-3;
    border-title-color: $primary-lighten-3;
    background: transparent;
}

.branch-picker:focus-within,
#create-title:focus,
#create-description:focus,
#create-reviewers:focus {
    border: round $accent;
    border-title-color: $accent;
}

.branch-picker {
    width: 1fr;
    height: auto;
}

.branch-picker Input {
    border: none;
    height: 1;
    padding: 0 1;
}

.branch-picker OptionList {
    border: none;
    height: 6;
    background: transparent;
}

#create-notes {
    display: none;
    padding: 0 2;
}

#create-title {
    height: 3;
}

#create-description {
    height: 10;
}

#create-reviewers,
#create-preview {
    width: 1fr;
    height: 10;
}

#create-preview {
    padding: 0 1;
}

#create-actions {
    height: auto;
    align: left middle;
    padding: 0 1;
}

#create-actions Checkbox {
    margin-right: 2;
}

#create-submit {
    margin-left: 2;
}
