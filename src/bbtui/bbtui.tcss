/* Rounded, titled borders on every panel, as in jiratui; the focused panel lights up. */

#search,
#review,
#starred,
#others,
#nightly,
#mine,
#pipelines,
#commits,
#commit-message,
#run-summary,
#run-steps,
#run-failures,
#run-log,
#confirm,
#pull-requests,
#summary,
#merge-checks,
#builds,
#reviewers,
#description,
#history,
#general-comments,
#file-chooser,
#diff-view,
.comment {
    border: round $primary-lighten-3;
    border-title-color: $primary-lighten-3;
    border-subtitle-color: $primary-lighten-3;
    background: transparent;
}

#search:focus,
#review:focus,
#starred:focus,
#others:focus,
#nightly:focus,
#mine:focus,
#pipelines:focus,
#commits:focus,
#commit-message:focus,
#run-steps:focus,
#run-failures:focus,
#run-log:focus,
#pull-requests:focus,
#overview-scroll:focus #summary,
#file-chooser:focus,
#diff-view:focus {
    border: round $accent;
    border-title-color: $accent;
    border-subtitle-color: $accent;
}

#search {
    height: 3;
    padding: 0 1;
}

#dashboard {
    height: 1fr;
}

#review {
    height: auto;
    max-height: 40%;
}

#starred {
    height: auto;
    max-height: 50%;
}

#others,
#pull-requests,
#diff-view {
    height: 1fr;
}

#file-chooser {
    height: auto;
    max-height: 12;
}

#general-comments {
    height: auto;
    padding: 0 1;
}

#summary,
#merge-checks,
#builds,
#reviewers,
#history {
    height: auto;
    padding: 0 1;
}

#checks-row {
    height: auto;
}

#merge-checks,
#builds {
    width: 1fr;
}

#description {
    height: auto;
    margin: 0;
    padding: 0 1;
}

.diff-lines {
    width: auto;
}

.comment {
    height: auto;
    margin: 0;
    padding: 0 1;
}

#diff-view .comment {
    width: 100%;
    max-width: 120;
}

TabPane {
    padding: 0;
}

/* Markdown spaces blocks with a bottom margin; drop it on the last block so boxes fit snugly. */
.comment > MarkdownBlock:last-child,
#description > MarkdownBlock:last-child {
    margin-bottom: 0;
}

/* Dashboard repository rows: name | description | updated, aligned in columns. */
.repo-row {
    height: 1;
    padding: 0 1;
}

.repo-name {
    width: 32;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.repo-description {
    width: 1fr;
    padding: 0 2;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.repo-updated {
    width: 14;
    text-align: right;
    color: $text-muted;
}

/* Comment cards are focusable (Tab or click) so `c` can reply to them. */
.comment:focus {
    border: round $accent;
    border-title-color: $accent;
}

CommentComposer {
    align: center middle;
    background: $background 60%;
}

#composer {
    width: 90%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 0 1;
}

#composer-quote {
    max-height: 6;
    margin-bottom: 1;
    border-left: thick $primary-lighten-3;
    padding-left: 1;
}

#composer-text {
    height: 12;
    border: none;
}

#composer-hint {
    margin-top: 1;
}

/* New pull request form */
#create-form {
    height: 1fr;
}

#create-branches,
#create-details {
    height: auto;
}

.branch-picker,
#create-title,
#create-description,
#create-reviewers,
#create-preview {
    border: round $primary-lighten-3;
    border-title-color: $primary-lighten-3;
    background: transparent;
}

.branch-picker:focus-within,
#create-title:focus,
#create-description:focus,
#create-reviewers:focus {
    border: round $accent;
    border-title-color: $accent;
}

.branch-picker {
    width: 1fr;
    height: auto;
}

.branch-picker Input {
    border: none;
    height: 1;
    padding: 0 1;
}

.branch-picker OptionList {
    border: none;
    height: 6;
    background: transparent;
}

#create-notes {
    display: none;
    padding: 0 2;
}

#create-title {
    height: 3;
}

#create-description {
    height: 10;
}

#create-reviewers,
#create-preview {
    width: 1fr;
    height: 10;
}

#create-preview {
    padding: 0 1;
}

#create-actions {
    height: auto;
    align: left middle;
    padding: 0 1;
}

#create-actions Checkbox {
    margin-right: 2;
}

#create-submit {
    margin-left: 2;
}

/* Dashboard columns: repositories on the left, your pull requests on the right. */
#repo-column {
    width: 3fr;
}

#right-column {
    width: 2fr;
}

#nightly {
    height: auto;
    max-height: 40%;
}

#mine {
    height: 1fr;
}

.pr-item {
    height: 2;
    padding: 0 1;
}

.pr-title,
.pr-meta {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Pipelines */
#pipelines,
#run-log {
    height: 1fr;
}

#run-top {
    height: auto;
}

#run-summary {
    height: auto;
    padding: 0 1;
}

#run-steps {
    height: auto;
    max-height: 7;
}

#run-failures {
    height: auto;
    max-height: 8;
}

#log-search {
    dock: bottom;
    margin-bottom: 1;
}

ConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#confirm {
    width: 70;
    height: auto;
    border: round $warning;
    border-title-color: $warning;
    background: $surface;
    padding: 1 2;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}

#confirm-buttons Button {
    margin-left: 2;
}

/* Merge dialog */
MergeScreen {
    align: center middle;
    background: $background 60%;
}

#merge-dialog {
    width: 90%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 0 1;
}

#merge-check-list {
    margin: 1 0;
}

#merge-strategy {
    width: 100%;
    margin-bottom: 1;
}

#merge-message {
    height: 8;
    margin-bottom: 1;
}

#merge-buttons {
    height: auto;
    align: right middle;
}

#merge-buttons Button {
    margin-left: 2;
}

/* URL dialog */
UrlScreen {
    align: center middle;
    background: $background 60%;
}

#url-dialog {
    width: auto;
    min-width: 50;
    max-width: 95%;
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 1 2;
}

#url-text {
    width: auto;
    margin-bottom: 1;
}

#url-buttons {
    width: auto;
    height: auto;
}

#url-buttons Button {
    margin-right: 2;
}

/* Commits */
#commits {
    height: 1fr;
}

#commit-message {
    height: auto;
    max-height: 10;
    padding: 0 1;
}

BranchChoiceScreen {
    align: center middle;
    background: $background 60%;
}

#branch-dialog {
    width: 80;
    max-width: 95%;
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 0 1;
}

#branch-dialog .branch-picker {
    width: 100%;
}

#branch-dialog OptionList {
    height: 10;
}

#branch-hint {
    margin-top: 1;
}
